# Copy to .env and fill in. Never share the real .env.
TELEGRAM_BOT_TOKEN=put_your_token_here
TELEGRAM_CHAT_ID=put_your_chat_id_here

# Only fill in the key for the provider you select in config.yaml
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional: overrides llm.ollama.host from config.yaml
OLLAMA_HOST=
